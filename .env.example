# =============================================================================
# RealtorDevOpsAI — Root Environment Variables
# Copy this file to .env and fill in your values.
# Service-specific examples also exist at backend/.env.example and frontend/.env.example
# =============================================================================

# ----- Database (PostgreSQL + PostGIS) -----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/realtor_devops

# ----- Redis -----
REDIS_URL=redis://localhost:6379/0

# ----- LLM Provider -----
# Active provider: "openai", "anthropic", "google", or "ollama"
LLM_PROVIDER=openai

# ----- OpenAI -----
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4

# ----- Anthropic -----
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ----- Google -----
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-2.0-flash

# ----- Ollama Cloud -----
OLLAMA_BASE_URL=https://cloud.ollama.com
OLLAMA_API_KEY=your-ollama-api-key-here
OLLAMA_MODEL=llama3

# ----- Ottawa Open Data -----
OTTAWA_OPEN_DATA_URL=https://open.ottawa.ca/api
GEO_OTTAWA_WFS_URL=https://maps.ottawa.ca/geoottawa/services/wfs
GEO_OTTAWA_WMS_URL=https://maps.ottawa.ca/geoottawa/services/wms

# ----- Mapbox -----
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token-here

# ----- Auth0 -----
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_API_AUDIENCE=https://api.realtordevopsai.com

# ----- App -----
DEBUG=false

# ----- Frontend (Vite) -----
VITE_MAPBOX_TOKEN=pk.your-mapbox-token-here
VITE_API_URL=http://localhost:8000
